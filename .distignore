# The ONE list of what never ships in the free zip. Read with rsync
# --exclude-from semantics by bin/build-zips.sh and scripts/build-release.mjs
# (npm run release). Gruntfile.js has no dist task, so there is no other list.
#
# Directories
# NOTE: entries are anchored with a leading "/" (root-relative) on purpose.
# Unanchored patterns match at ANY depth in both `wp dist-archive` and the
# rsync --exclude list built by bin/build-zips.sh — an unanchored "vendor"
# used to strip assets/vendor/ (lucide.min.js) out of the release zip and
# 404 every icon on the frontend. Only .git / node_modules stay unanchored
# (they must never ship at any depth).
#
# Every top-level dotfile and dot-directory (.github, .wordpress-org,
# .eslintrc.json, .pa11yci, .phpcs.xml.dist, .phpcs-cache, .superpowers, ...).
# Nothing at the root that starts with a dot is ever runtime, so new config
# files are excluded without anyone having to remember to list them.
/.*
.git
node_modules
.gitkeep
/tests
/vendor
/dist
/docs
/bin
/build
# Finder/rsync duplicates ("build 2", "dist 2") are untracked scratch, but the
# anchored /build above does not match them. One such folder put 24 empty
# vendor/squizlabs/... directory entries inside the shipped free zip - no dev
# files, but a wp.org reviewer opening the zip would see a phpcs tree.
/build */
/dist */
/coverage
/audit
/plan
/plans

# Build files
composer.json
composer.lock
package.json
package-lock.json
Gruntfile.js
phpunit.xml
phpunit.xml.dist
phpcs.xml
phpcs.xml.dist
phpcbf.xml
phpcbf.xml.dist
phpstan.neon
phpstan.neon.dist
phpstan-bootstrap.php
phpstan-baseline.neon
phpstan-combined.neon.dist

# Marketing (don't ship to WP.org)
sales-page.html
marketing

# Documentation and every other markdown file, at any depth.
# Enumerating names by hand is what let AUDIT-VERDICT.md reach the 3.1.0
# customer zip: it was not on the list, so nothing stopped it. Customer zips
# ship readme.txt, never *.md - so match the extension, not the filenames.
*.md
README.md
CHANGELOG.md
ROADMAP.md
CONTRIBUTING.md
CLAUDE.md
AUDIT-VERDICT.md

# IDE/Editor files
.idea
.vscode
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Internal scripts (root-relative)
/scripts
