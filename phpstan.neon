parameters:
    level: 7
    phpVersion: 70400
    paths:
        - includes/
        - wb-ads-rotator-with-split-test.php
    excludePaths:
        - tests/*
        - vendor/*
        - dist/*
        - docs/*
        - plan/*
        - plans/*
        - marketing/*
    scanFiles:
        # BuddyPress is an optional runtime dependency — resolved for static
        # analysis only so its guarded call sites aren't reported "not found".
        - tests/stubs/buddypress.php
    scanDirectories:
        # Vendored MaxMind DB reader (libs/maxmind-db-reader/README.md) - not
        # in phpstan's `paths` (never linted/analyzed, same as the rest of
        # libs/), just made resolvable so Geo_Engine::query_maxmind()'s
        # \MaxMind\Db\Reader usage isn't reported "class not found".
        - libs/maxmind-db-reader/src
    bootstrapFiles:
        - phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

includes:
    - phpstan-baseline.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
